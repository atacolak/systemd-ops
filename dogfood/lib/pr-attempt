#!/usr/bin/env bash
# OMP-domain PR transactional attempts. Sourced, never executed.
# Durable progress is fork/$HEAD_BRANCH. Scratch worktrees are disposable.

PR_ATTEMPT_ROOT=${PR_ATTEMPT_ROOT:-/home/sf/workspace/worktrees/omp-automation}
PR_FAILURE_BUDGET=${PR_FAILURE_BUDGET:-${FAILURE_BUDGET:-2}}
FAILURE_BUDGET=${PR_FAILURE_BUDGET}

pr_attempt_path() {
  local iteration=${1:?}
  printf '%s/%s/%s\n' "$PR_ATTEMPT_ROOT" "$OPERATION_STEM" "$iteration"
}

pr_attempt_base_repo() {
  if [[ -n "${GIT_BASE:-}" ]]; then
    printf '%s\n' "$GIT_BASE"
    return 0
  fi
  local bound=${BOUND_WORKTREE:-${WORKTREE:-}}
  if [[ -n "$bound" && ( -d "$bound/.git" || -f "$bound/.git" ) ]]; then
    git -C "$bound" rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
      | sed 's|/\.git$||'
    return 0
  fi
  printf '%s\n' "$SCOPE_ROOT"
}

create_pr_attempt() {
  local branch=$1
  local iteration=$2
  local base path start
  base=$(pr_attempt_base_repo) || return 1
  git -C "$base" fetch --quiet fork "$branch" || return 1
  start=$(git -C "$base" rev-parse "fork/$branch") || return 1
  ATTEMPT_START_HEAD=$start
  path=$(pr_attempt_path "$iteration")
  mkdir -p "$(dirname -- "$path")"
  if [[ -e "$path" ]]; then
    echo "attempt path already exists: $path" >&2
    return 1
  fi
  git -C "$base" worktree add --detach "$path" "$start" >/dev/null || return 1
  ATTEMPT_WORKTREE=$path
  export ATTEMPT_WORKTREE ATTEMPT_START_HEAD
  printf '%s\n' "$path"
}

attempt_dirty_files() {
  local tree=${1:-$ATTEMPT_WORKTREE}
  git -C "$tree" status --porcelain=v1 --untracked-files=normal
}

log_pr_attempt_aftermath() {
  local kind=$1
  local code=$2
  local tree=${ATTEMPT_WORKTREE:-}
  local start=${ATTEMPT_START_HEAD:-unknown}
  local final=missing
  local dirty="" n=0
  if [[ -n "$tree" && ( -d "$tree/.git" || -f "$tree/.git" ) ]]; then
    final=$(git -C "$tree" rev-parse HEAD 2>/dev/null || echo missing)
    dirty=$(attempt_dirty_files "$tree" || true)
    n=$(printf '%s' "$dirty" | grep -c . || true)
  fi
  echo "PR #${PR_NUMBER:-?} attempt ${iteration_id:-unknown}"
  echo "result: $kind (exit $code)"
  echo "starting fork head: $start"
  echo "final attempt HEAD: $final"
  if [[ "$final" != "$start" && "$final" != missing ]]; then
    echo "attempt HEAD changed; unpushed SHA $final not resumed"
  fi
  echo "dirty files: $n"
  if [[ -n "$dirty" ]]; then
    printf '%s\n' "$dirty" | sed 's/^/  /'
  fi
  echo "uncommitted attempt discarded"
}

dispose_pr_attempt() {
  local tree=${ATTEMPT_WORKTREE:-}
  [[ -n "$tree" ]] || return 0
  local base
  base=$(pr_attempt_base_repo) || true
  rm -rf "$tree"
  if [[ -n "$base" && ( -d "$base/.git" || -f "$base/.git" ) ]]; then
    git -C "$base" worktree prune >/dev/null 2>&1 || true
  fi
  ATTEMPT_WORKTREE=""
}

# Park an input whose operational failures exhausted the budget. This park is
# operational, not semantic: the input stays unprocessed so the next tick
# retries it, and the failure-budget entry plus the blocker are the durable
# record. Marking the input processed here is what certified it forever and left
# the PR unable to converge. The blocker carries the real kind of the failures
# that caused it, iteration-failed; semantic-blocked is reserved for a genuine
# semantic blocked report. The sidecar records the fingerprint this park
# covered, which bounds the retry without certifying the input.
park_pr_input() {
  local input=$1
  local kind=$2
  local n=${3:-$PR_FAILURE_BUDGET}
  local summary="PR parked after ${n} identical $kind failures on unchanged input"
  record_blocker iteration-failed 0 "$summary" "${iteration_id:-}" parent "$input" || true
  record_operational_park "$input" "$kind" || true
}
