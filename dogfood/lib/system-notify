#!/usr/bin/env bash
# Shared HCOM notification seam. Sourced, never executed.
#
# system_notify <source-id> <intent> <message> sends one automation
# notification as sender_kind=system: HCOM records the durable source id
# instead of a borrowed actor identity. The send is always addressed to the
# scope's coordination.lead, so it can never become a broadcast. The reserved
# source id `overseer` is refused.
#
# Returns 0 after delivery, 2 when the notification is refused or the lead
# cannot be resolved, and hcom's own status when hcom fails. Nothing is sent
# before the source id, the intent, and coordination.lead all validate.
#
# Binaries and the scope root come from the environment the same way the rest
# of the wrapper library takes them: HCOM_BIN, ACTOR_BIN, SYSTEMD_OPS_BIN,
# SYSTEMD_OPS_SCOPE_ROOT, then SCOPE_ROOT. They are read at call time, so
# sourcing this file has no effect at all.

# Wakes a lead that is not live, once. `$ACTOR_BIN status` is the only source
# of truth about liveness. Wake failures are ignored: the notification is what
# matters, and a missing actor binary skips this step silently.
system_notify_wake_lead() {
  local name=$1
  local actor_bin=${ACTOR_BIN:-/home/sf/.local/bin/actor}
  local out lifecycle

  if [[ ! -x $actor_bin ]]; then
    return 0
  fi
  out=$("$actor_bin" status "$name" 2>&1) || true
  lifecycle=$(sed -n 's/.*"lifecycle"[[:space:]]*:[[:space:]]*"\([a-zA-Z_]*\)".*/\1/p' <<<"$out" | head -n 1)
  if [[ -n $lifecycle ]]; then
    case $lifecycle in
      stopped|idle|exited|dead) ;;
      *) return 0 ;;
    esac
  else
    case $out in
      *stopped*|*idle*|*exited*|*dead*) ;;
      *) return 0 ;;
    esac
  fi
  "$actor_bin" r "$name" >/dev/null 2>&1 || true
  return 0
}

system_notify() {
  if [[ $# -ne 3 ]]; then
    echo "system_notify: usage: system_notify <source-id> <intent> <message>" >&2
    return 2
  fi

  local source_id=$1
  local intent=$2
  local message=$3
  local scope_root=${SYSTEMD_OPS_SCOPE_ROOT:-${SCOPE_ROOT:-/home/sf/workspace/oh-my-pi}}
  local systemd_ops_bin=${SYSTEMD_OPS_BIN:-/home/sf/.local/bin/systemd-ops}
  local hcom_bin=${HCOM_BIN:-/home/sf/.local/bin/hcom}
  local scope_json lead_handle lead_name rc

  if [[ ! $source_id =~ ^[a-z0-9][a-z0-9._:-]*$ ]]; then
    echo "system_notify: source id '$source_id' is not [a-z0-9][a-z0-9._:-]*" >&2
    return 2
  fi
  if [[ $source_id == overseer ]]; then
    echo "system_notify: source id 'overseer' is reserved" >&2
    return 2
  fi

  case $intent in
    request|inform|ack) ;;
    *)
      echo "system_notify: intent '$intent' is not request|inform|ack" >&2
      return 2
      ;;
  esac

  if ! scope_json=$("$systemd_ops_bin" --json --manager user --scope-root "$scope_root" --cwd "$scope_root" scope show 2>/dev/null); then
    echo "system_notify: scope show failed in $scope_root" >&2
    return 2
  fi
  lead_handle=$(jq -r '.data.coordination.lead // .coordination.lead // empty' <<<"$scope_json" 2>/dev/null || true)
  if [[ -z $lead_handle || $lead_handle == null ]]; then
    echo "no coordination.lead bound in $scope_root" >&2
    return 2
  fi
  if [[ ! $lead_handle =~ ^hcom:[a-z]{4}$ ]]; then
    echo "system_notify: coordination.lead is not an hcom:<four letters> handle: $lead_handle" >&2
    return 2
  fi
  lead_name=${lead_handle#hcom:}

  system_notify_wake_lead "$lead_name"

  rc=0
  "$hcom_bin" send --as-system "$source_id" "@$lead_name" --intent "$intent" -- "$message" || rc=$?
  if (( rc != 0 )); then
    echo "system_notify: hcom send as $source_id to @$lead_name failed with status $rc" >&2
    return "$rc"
  fi
  return 0
}
