#!/usr/bin/env bash
# Shared HCOM notification seam. Sourced, never executed.
#
# system_notify <source-id> <intent> <message> sends one automation
# notification as sender_kind=system: HCOM records the durable source id
# instead of a borrowed identity. The send is always addressed to the
# scope's coordination.lead, so it can never become a broadcast. The reserved
# source id `overseer` is refused.
#
# Returns 0 after delivery, 2 when the notification is refused or the lead
# cannot be resolved, hcom's own status when hcom fails, and the timeout status
# (124) when the delivery send is killed at its bound. Nothing is sent before
# the source id, the intent, and coordination.lead all validate. A source id is
# 1 to 50 characters of [a-z0-9] followed by [a-z0-9_:-]. That is
# a strict subset of HCOM's [A-Za-z0-9_-:] charset, and the narrowing is
# deliberate: no uppercase, and a first character that has to be alphanumeric,
# so a leading _, : or - is refused here even though it is inside HCOM's
# charset. An id that passes this check therefore cannot fail at HCOM's own
# charset check.
#
# Both charset checks name their characters one at a time rather than through
# [a-z] ranges, because a range is expanded through the collation in force and
# under a UTF-8 locale also matches accented lowercase letters, which HCOM then
# refuses.
#
# Binaries, the scope root, and the hcom call bounds come from the environment
# the same way the rest of the wrapper library takes them: HCOM_BIN,
# SYSTEMD_OPS_BIN, SYSTEMD_OPS_SCOPE_ROOT, then SCOPE_ROOT, HCOM_TIMEOUT for
# the seconds the roster read and the resume may each take before they are
# killed and treated as a failure (default 5), and HCOM_SEND_TIMEOUT for the
# seconds the delivery send may take before it is killed and reported as a
# failed delivery (default 30). The send bound is the larger one because a
# delivery can legitimately take longer than a roster read. They are read at
# call time, so sourcing this file has no effect at all.
#
# The roster read and the resume are bounded by HCOM_TIMEOUT, the delivery send
# by HCOM_SEND_TIMEOUT. A send timeout is reported rather than swallowed: the
# seam returns the timeout status and writes the timeout and the recipient to
# stderr, so a caller can tell a timeout from an hcom error. A killed send may
# still have been accepted by HCOM, so a caller that retries a timed-out send
# can duplicate a notification. A bound cannot make a hung transport deliver;
# it converts a permanent hang into a failure. The watcher unit is Type=oneshot
# with TimeoutStartUSec=infinity, so a send that never returned would leave the
# watcher alive and notifying nothing.

# Bounds one hcom call. $1 is the seconds the call may take before it is killed
# and treated like any other failure; each caller reads its own bound,
# HCOM_TIMEOUT or HCOM_SEND_TIMEOUT, at call time. Where `timeout` is not
# available the call is made unbounded rather than skipped, so the seam keeps
# working.
system_notify_hcom_call() {
  local hcom_timeout=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$hcom_timeout" "$@"
  else
    "$@"
  fi
}

# Resumes a lead that is not live, once, with the HCOM bus resume. The roster
# from `hcom list --all --json` is the only source of truth about liveness: a
# lead named there with an empty, stopped, idle, exited, or dead status is
# resumed with `hcom r <name> --go`. A lead that is live, absent from the
# roster, or read from a roster that cannot be parsed is left alone, and a row
# whose name is null, missing, or not a string is skipped rather than aborting
# the match. Both calls are best effort: their output is discarded, their
# status is ignored, each is bounded by HCOM_TIMEOUT, and no failure or hang
# here can stop the notification.
system_notify_wake_lead() {
  local name=$1
  local hcom_bin=${HCOM_BIN:-/home/sf/.local/bin/hcom}
  local hcom_timeout=${HCOM_TIMEOUT:-5}
  local roster lead_row lead_status

  roster=$(system_notify_hcom_call "$hcom_timeout" "$hcom_bin" list --all --json 2>/dev/null || true)
  lead_row=$(jq -c --arg n "$name" '
    if type == "array" then . else [] end
    | map(select((.base_name == $n) or (.name // "" | tostring | test("(^|-)" + $n + "$"))))
    | .[0] // empty
  ' <<<"$roster" 2>/dev/null || true)
  if [[ -z $lead_row ]]; then
    return 0
  fi
  lead_status=$(jq -r '.status // empty' <<<"$lead_row" 2>/dev/null || true)
  case $lead_status in
    stopped|idle|exited|dead|"")
      system_notify_hcom_call "$hcom_timeout" "$hcom_bin" r "$name" --go >/dev/null 2>&1 || true
      ;;
  esac
  return 0
}

system_notify() {
  if [[ $# -ne 3 ]]; then
    echo "system_notify: usage: system_notify <source-id> <intent> <message>" >&2
    return 2
  fi

  local source_id=$1
  local intent=$2
  local message=$3
  local scope_root=${SYSTEMD_OPS_SCOPE_ROOT:-${SCOPE_ROOT:-/home/sf/workspace/oh-my-pi}}
  local systemd_ops_bin=${SYSTEMD_OPS_BIN:-/home/sf/.local/bin/systemd-ops}
  local hcom_bin=${HCOM_BIN:-/home/sf/.local/bin/hcom}
  local hcom_send_timeout=${HCOM_SEND_TIMEOUT:-30}
  local scope_json lead_handle lead_name rc
  # The accepted charset, spelled out one character at a time. A range such as
  # [a-z] is expanded through the ambient collation, and under a UTF-8 locale
  # it also matches accented lowercase letters such as U+00E9, so the range
  # would accept an id that HCOM, whose charset is [A-Za-z0-9_-:], then
  # refuses. These lists are the charset in every locale.
  local ascii_lower='abcdefghijklmnopqrstuvwxyz'
  local ascii_digit='0123456789'

  if [[ ! $source_id =~ ^[$ascii_digit$ascii_lower][$ascii_digit${ascii_lower}_:-]*$ || ${#source_id} -gt 50 ]]; then
    echo "system_notify: source id '$source_id' is not 1-50 characters of [a-z0-9] followed by [a-z0-9_:-]" >&2
    return 2
  fi
  if [[ $source_id == overseer ]]; then
    echo "system_notify: source id 'overseer' is reserved" >&2
    return 2
  fi

  case $intent in
    request|inform|ack) ;;
    *)
      echo "system_notify: intent '$intent' is not request|inform|ack" >&2
      return 2
      ;;
  esac

  if ! scope_json=$("$systemd_ops_bin" --json --manager user --scope-root "$scope_root" --cwd "$scope_root" scope show 2>/dev/null); then
    echo "system_notify: scope show failed in $scope_root" >&2
    return 2
  fi
  lead_handle=$(jq -r '.data.coordination.lead // .coordination.lead // empty' <<<"$scope_json" 2>/dev/null || true)
  if [[ -z $lead_handle || $lead_handle == null ]]; then
    echo "no coordination.lead bound in $scope_root" >&2
    return 2
  fi
  # The same charset care as the source id: [a-z] here would also match an
  # accented letter under a UTF-8 collation.
  if [[ ! $lead_handle =~ ^hcom:[$ascii_lower]{4}$ ]]; then
    echo "system_notify: coordination.lead is not an hcom:<four letters> handle: $lead_handle" >&2
    return 2
  fi
  lead_name=${lead_handle#hcom:}

  system_notify_wake_lead "$lead_name"

  rc=0
  system_notify_hcom_call "$hcom_send_timeout" "$hcom_bin" send --as-system "$source_id" "@$lead_name" --intent "$intent" -- "$message" || rc=$?
  if (( rc != 0 )); then
    # `timeout` reports a call it killed as 124. This is a delivery failure
    # like any other: it is not retried, and HCOM may already have accepted the
    # message.
    if (( rc == 124 )); then
      echo "system_notify: hcom send as $source_id to @$lead_name timed out after ${hcom_send_timeout}s" >&2
    else
      echo "system_notify: hcom send as $source_id to @$lead_name failed with status $rc" >&2
    fi
    return "$rc"
  fi
  return 0
}
