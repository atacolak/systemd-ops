#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: capability-maintainer-run BRANCH OPERATION_STEM WORKTREE" >&2
  exit 2
fi

BRANCH=$1
OPERATION_STEM=$2
WORKTREE=$3
SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
SCOPE_ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd)
OPERATION_HOME="$SCOPE_ROOT/.systemd-ops/operations/$OPERATION_STEM"
STATE_DIR="$OPERATION_HOME/state"


SYSTEMD_OPS_BIN=${SYSTEMD_OPS_BIN:-/home/sf/.local/bin/systemd-ops}
OMP_BIN=${OMP_BIN:-/home/sf/.local/bin/omp-policy}
AGENT_CWD=${AGENT_CWD:-/home/sf/worlds/automation-agents}
MAX_INTELLIGENT_PASSES=${MAX_INTELLIGENT_PASSES:-3}

export SYSTEMD_OPS_SCOPE_ROOT="$SCOPE_ROOT"
export SYSTEMD_OPS_OPERATION="$OPERATION_STEM"
export PATH="/home/sf/.bun/bin:/home/sf/.local/bin:/usr/local/bin:/usr/bin:/bin"

# shellcheck source=../lib/automation-wrapper
source "$SCOPE_ROOT/.systemd-ops/lib/automation-wrapper"
# shellcheck source=../lib/pr-settlement
source "$SCOPE_ROOT/.systemd-ops/lib/pr-settlement"
# shellcheck source=../lib/pr-review-state
source "$SCOPE_ROOT/.systemd-ops/lib/pr-review-state"
# shellcheck source=../lib/omp-session
source "$SCOPE_ROOT/.systemd-ops/lib/omp-session"

# A capability pass that exits 0 without calling automation_report is normally a
# contract failure, and the run parks on it. When the driver can machine-verify
# that there was nothing to change, that dead end is a false alarm. A pass is a
# VERIFIED NO-OP only when all four of these hold:
#   1. the pass exited 0
#   2. the bound worktree is clean: plain `git status --porcelain` prints nothing,
#      so tracked modifications and new untracked files both disqualify (ignored
#      files are not shown by plain porcelain and are fine)
#   3. the target generation is an ancestor of HEAD
#   4. there is no capability-local unpublished delta: merging HEAD and the target
#      from their merge base prints nothing
# Condition 3 is what stops a tree that merely has the right branch name, or one
# that descends from some other generation, from self-reporting READY: a tree
# missing the target ancestor is NOT a no-op, it is unready and must keep
# failing. Condition 3 holding means `git merge-base HEAD <target>` IS the
# target, so condition 4 calls the three-argument merge-tree with the base and
# the third tree identical and prints nothing for every input: condition 4 is
# currently implied by condition 3 and can never change the decision. It is kept
# because it is the runtime owner's specified no-op command, not because it can
# fire. Read-only, no side effects.
capability_pass_is_verified_noop() {
  local pass_exit=$1
  local generation=$2
  local worktree=$3
  local dirty base delta
  [[ $pass_exit -eq 0 ]] || return 1
  [[ -n "$generation" ]] || return 1
  dirty=$(git -C "$worktree" status --porcelain) || return 1
  [[ -z "$dirty" ]] || return 1
  git -C "$worktree" merge-base --is-ancestor "$generation" HEAD || return 1
  base=$(git -C "$worktree" merge-base HEAD "$generation") || return 1
  [[ -n "$base" ]] || return 1
  delta=$(git -C "$worktree" merge-tree "$base" HEAD "$generation") || return 1
  [[ -z "$delta" ]] || return 1
  return 0
}

# True only when the pass's own iteration is still open and carries no report.
# Anything else, including an unreadable operator surface, keeps the existing
# behaviour: the driver never overrides a report the agent already made.
capability_pass_awaiting_report() {
  local view
  view=$(ops_bound operator show --unit "$OPERATION_STEM") || return 1
  jq -e '(.data.operator.active_iteration != null)
    and (.data.operator.active_iteration.reported_at == null)' <<<"$view" >/dev/null
}

# True when any admitted desired input is not present in the bound worktree.
# Absent desired-inputs.json is consumed. A READY certify is forbidden while
# this returns 0.
# Commit, or any input with artifact_revision set: revision must be an
# ancestor of HEAD. Worktree-delta: each named path must exist under
# WORKTREE and sha256 of the file bytes must equal the admitted 64-lowercase-hex.
capability_desired_unconsumed() {
  local file="$STATE_DIR/desired-inputs.json"
  local kind rev path expected actual
  [[ -e "$file" ]] || return 1
  jq -e '.version == 1 and (.inputs | type == "array")' "$file" >/dev/null 2>&1 || return 0
  while IFS=$'\t' read -r kind rev; do
    if [[ "$kind" == commit || -n "$rev" ]]; then
      [[ -n "$rev" ]] || return 0
      git -C "$WORKTREE" merge-base --is-ancestor "$rev" HEAD || return 0
    fi
  done < <(jq -r '.inputs[] | [(.artifact_kind // ""), (.artifact_revision // "")] | @tsv' "$file")
  while IFS=$'\t' read -r path expected; do
    [[ -n "$path" ]] || return 0
    [[ -f "$WORKTREE/$path" ]] || return 0
    actual=$(sha256sum -- "$WORKTREE/$path" | awk '{print $1}')
    [[ "$actual" == "$expected" ]] || return 0
  done < <(jq -r '.inputs[] | select(.artifact_kind == "worktree-delta") | (.delta // [])[] | [(.path // ""), (.sha256 // "")] | @tsv' "$file")
  return 1
}

pre_clean_worktree=$WORKTREE
ensure_clean_worktree "$BRANCH" || exit $?
# A rebind abandons the old tree. When the abandoned tree is itself a
# recovered tree, its default-root session bucket is a recovered-tree
# session and is not left behind. Original-tree buckets stay: they hold
# capability history and possibly human sessions.
if [[ $WORKTREE != "$pre_clean_worktree" ]]; then
  gc_recovered_tree_session_bucket "$pre_clean_worktree" || true
fi
git -C "$WORKTREE" fetch --quiet fork main || true
upstream_generation=$(resolve_target_generation) || exit $?


current_input=$(observe_input) || exit $?
if input_is_processed "$current_input"; then
  exit 0
fi
# An operational park bounds the retry instead of certifying the input: while
# the observation still matches a park that binds it, this tick does no work.
# A crash park stops binding PARK_CRASH_COOLDOWN_SECONDS after parked_at; every
# other kind is fingerprint-terminal until the input moves or an operator
# releases the park. The skip reports nothing, writes no processed state and
# clears no blocker or budget; it only declines to burn a pass.
if input_matches_operational_park "$current_input"; then
  exit 0
fi
wake_input=$current_input



mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
exec 9>"$STATE_DIR/.wake.lock"

if ! flock -n 9; then
  exit 0
fi

passes=0
while (( passes < MAX_INTELLIGENT_PASSES )); do
  upstream_generation=$(resolve_target_generation) || exit $?

  context=$(automation_context_json) || exit $?
  current_input=$(observe_input) || exit $?
  if input_is_processed "$current_input"; then
    exit 0
  fi
  # Same bound as the pre-lock check: an unchanged parked input does no work.
  if input_matches_operational_park "$current_input"; then
    exit 0
  fi
  wake_input=$current_input



  child_revision_before=$(capability_child_revision_digest "$context") || exit $?
  pr_child_revision_before=$(pr_children_settled_revision "$context") || exit $?

  checkpoint_generation=""
  if [[ -r "$STATE_DIR/checkpoint.json" ]]; then
    checkpoint_generation=$(jq -r '.generation // empty' "$STATE_DIR/checkpoint.json")
  fi
  now=${PR_SETTLE_NOW:-$(date +%s)}
  critical_fast=0
  gate=""
  if capability_has_fresh_critical_clear "$context" "$SCOPE_ROOT" "$checkpoint_generation" "$upstream_generation"; then
    if pr_children_running "$context"; then
      echo "critical repair is pending but a child PR is still mutating; leaving capability stale" >&2
      exit 0
    fi
    critical_fast=1
  else
    gate=$(capability_release_gate "$context" "$upstream_generation" "$checkpoint_generation" "$now" "$STATE_DIR/pr-quiet.json" "$STATE_DIR/pr-release-grace.json") || true
    case "$gate" in
      launch|launch-grace) ;;
      wait-unsettled)
        echo "PR children are not settled for $upstream_generation; leaving capability stale" >&2
        exit 0
        ;;
      wait-quiet)
        echo "PR children settled for $upstream_generation but quiet window is open; leaving capability stale" >&2
        exit 0
        ;;
      *)
        echo "PR children are not settled for $upstream_generation; leaving capability stale" >&2
        exit 0
        ;;
    esac
  fi

  start_json=$(ops_bound operator iteration-start --unit "$OPERATION_STEM") || exit $?
  iteration_id=$(jq -er '.data.iteration_id' <<<"$start_json") || exit $?
  passes=$((passes + 1))

  extra_prompt=""
  if [[ $critical_fast -eq 1 ]]; then
    extra_prompt="A verified P0/P1 repair was confirmed by current-head Codex rereview (critical-cleared). Inspect that PR change, integrate only the needed local correctness repair, verify, and checkpoint. Do not blindly merge. Other capabilities must not rerun."
  elif [[ "$gate" == launch-grace ]]; then
    unsettled=$(pr_unsettled_units "$context" "$upstream_generation" | tr '\n' ' ')
    extra_prompt="Release settlement grace expired. These publication streams did not settle: ${unsettled}. Preserve local capability continuity. Use the existing known-good Capability plus target release. Only incorporate stable committed PR-branch changes you can independently verify. Do not read or consume an automation attempt worktree. Do not wait for publication automation merely because it is operationally stuck."
  elif [[ -n "$checkpoint_generation" && "$checkpoint_generation" != "$upstream_generation" ]]; then
    extra_prompt="This is a release-generation pass. Consume the target generation, the known-good local capability, and accumulated useful PR-child improvements. Do not require every PR READY. Do not blindly merge every PR head."
  fi

  "$OMP_BIN" -p --agent capability-maintainer --agent-cwd "$AGENT_CWD" \
    --cwd "$WORKTREE" --approval-mode yolo --max-time 60m \
    "Repository: atacolak/oh-my-pi
Capability branch: $BRANCH
Operation stem: $OPERATION_STEM
Worktree: $WORKTREE
Required target generation: $upstream_generation

Call automation_report with outcome=ready or outcome=blocked before exit.
BLOCKED reports require route=self|parent.
PR children are publication/review streams, not semaphores. Maintain the local capability against the target generation even if a child PR is BLOCKED. Only BLOCKED if the LOCAL capability cannot be made correct. $extra_prompt Perform exactly one capability maintenance pass, then exit."

  omp_code=$?

  # A verified no-op pass that never called automation_report would otherwise
  # burn a contract-failure park, so the driver emits that READY report itself
  # instead of depending on agent compliance. Ordering is load bearing:
  # automation report needs a live iteration and iteration-finish consumes it,
  # so the report is written before the finish below. The agent's own report
  # always wins: when the pass reported, this iteration already carries it, the
  # driver stays silent, and nothing new happens.
  if [[ $omp_code -eq 0 ]] \
    && capability_pass_awaiting_report \
    && capability_pass_is_verified_noop "$omp_code" "$upstream_generation" "$WORKTREE" \
    && ! capability_desired_unconsumed; then
    # automation report rejects a headline over 80 characters
    # (MAX_AUTOMATION_HEADLINE), and a rejected report would park the run, so
    # the branch field gets the budget left by the fixed tail instead of an
    # assumed length: a branch that does not fit is elided to the budget.
    noop_tail=" already correct for ${upstream_generation:0:8}; verified no-op"
    noop_headline_budget=$((80 - ${#noop_tail}))
    noop_branch=$BRANCH
    if (( ${#noop_branch} > noop_headline_budget )); then
      noop_branch="${noop_branch:0:noop_headline_budget-3}..."
    fi
    noop_headline="$noop_branch$noop_tail"
    noop_summary=$(jq -cn '[
      "capability pass exited 0 without an automation_report",
      "worktree clean: git status --porcelain is empty",
      "target generation is an ancestor of HEAD: git merge-base --is-ancestor holds",
      "merge-tree from the merge base is empty"
    ]')
    # A rejected report must not park silently. The output is kept and echoed to
    # stderr, and the pass still falls through to the contract-failure path
    # below, which is unchanged.
    noop_report=$(ops_bound automation report --headline "$noop_headline" \
      --summary "$noop_summary" --outcome ready 2>&1) || {
      echo "verified no-op self-report was rejected:" >&2
      printf '%s\n' "$noop_report" >&2
    }
  fi

  finish_json=$(finish_iteration "$omp_code")
  finish_code=$?
  if [[ $omp_code -ne 0 ]]; then
    kind=crash
    if [[ $omp_code -eq 124 ]]; then
      kind=timeout
    fi
    if operational_failure_maybe_park "$wake_input" "$kind" "$omp_code"; then
      exit 0
    fi
    exit "$omp_code"
  fi
  if [[ $finish_code -ne 0 ]]; then
    if operational_failure_maybe_park "$wake_input" crash "$finish_code"; then
      exit 0
    fi
    exit "$finish_code"
  fi
  reconsolidated=$(jq -r '.data.reconsolidated // false' <<<"$finish_json") || exit $?
  if [[ "$reconsolidated" != true ]]; then
    echo "automation_report is required before a successful maintainer exit" >&2
    if operational_failure_maybe_park "$wake_input" contract-failure 3; then
      exit 0
    fi
    exit 3
  fi

  outcome=$(report_outcome_from_finish "$finish_json")
  route=$(report_route_from_finish "$finish_json")
  post_context=$(automation_context_json) || exit $?
  child_revision_after=$(capability_child_revision_digest "$post_context") || exit $?
  pr_child_revision_after=$(pr_children_settled_revision "$post_context") || exit $?

  post_upstream_generation=$(resolve_target_generation) || exit $?

  post_input=$(observe_input) || exit $?

  if [[ "$child_revision_after" != "$child_revision_before" || "$pr_child_revision_after" != "$pr_child_revision_before" ]]; then
    echo "child input changed during capability pass; reevaluating" >&2
    continue
  fi

  if [[ "$outcome" == blocked ]]; then
    summary=$(jq -r '.data.operator.headline // .data.operator.body // "blocked"' <<<"$finish_json")
    mark_processed "$post_input" blocked || exit $?
    record_blocker semantic-blocked 0 "$summary" "$iteration_id" "${route:-self}" "$post_input" || true
    clear_failure_budget
    exit 0
  fi

  if [[ "$outcome" != ready ]]; then
    echo "automation_report outcome must be ready or blocked" >&2
    record_blocker contract-failure 3 "automation_report outcome must be ready or blocked" "$iteration_id" parent "$post_input" || true
    exit 3
  fi

  if [[ "$post_upstream_generation" != "$upstream_generation" ]]; then
    echo "target generation advanced during maintenance; refusing a stale checkpoint" >&2
    record_blocker stale-generation 4 "target generation advanced during maintenance; refusing a stale checkpoint" "$iteration_id" parent "$post_input" || true
    exit 4
  fi

  post_head=$(git -C "$WORKTREE" rev-parse HEAD) || exit $?
  if ! git -C "$WORKTREE" merge-base --is-ancestor "$upstream_generation" "$post_head"; then
    echo "capability branch did not process required target generation $upstream_generation" >&2
    record_blocker postcondition-failed 4 "capability branch did not process required target generation $upstream_generation" "$iteration_id" parent "$post_input" || true
    exit 4
  fi
  if capability_desired_unconsumed; then
    echo "desired inputs are unconsumed; refusing READY certify" >&2
    record_blocker postcondition-failed 4 "desired inputs are unconsumed; refusing READY certify" "$iteration_id" parent "$post_input" || true
    exit 4
  fi

  mark_processed "$post_input" ready || exit $?
  write_output_checkpoint "$post_input" "$upstream_generation" "$post_head" || {
    echo "structured checkpoint write failed" >&2
    record_blocker postcondition-failed 4 "structured checkpoint write failed" "$iteration_id" parent "$post_input" || true
    exit 4
  }
  clear_failure_budget
  if [[ $critical_fast -eq 1 ]]; then
    mark_critical_consumed "$post_context" "$SCOPE_ROOT" || true
  fi


  notify_parent checkpoint
  exit 0
done

echo "child input kept changing; leaving processed fingerprint stale" >&2
exit 0
