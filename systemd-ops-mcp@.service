# systemd-ops-mcp: one hardened server per connection.
#
# A template, instantiated by systemd-ops-mcp.socket for each connection.
# An MCP client that spawns the binary itself needs none of this; the
# file is here for the case where an instance is supervised instead,
# and for the hardening, which is worth copying either way.

[Unit]
Description=Model Context Protocol server for systemd (read-only grants)
Documentation=man:systemd-ops-mcp(1)

[Service]
# Read scopes only. units:write is not granted here; add it only when
# this instance is expected to operate the machine rather than inspect
# it.
ExecStart=/usr/local/bin/systemd-ops-mcp --manager system --grant units:read,journal:read,boot:read
DynamicUser=yes
SupplementaryGroups=systemd-journal

# The connection is the protocol stream. Diagnostics must not go to it:
# stderr inherits stdout unless told otherwise, and a startup error
# written into the stream would reach the client as a protocol parse
# error rather than as the message it is.
StandardInput=socket
StandardOutput=socket
StandardError=journal

# Full hardening. This instance grants read scopes only, so nothing
# here should hurt; if you grant units:write above, the hardening still
# applies, since systemctl talks to PID 1 over D-Bus, not the filesystem.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=

# The server talks to PID 1 over a Unix socket and runs systemctl,
# which talks D-Bus over another one. It opens no network socket, so
# deny IP traffic outright. RestrictAddressFamilies= is deliberately
# not set: AF_UNIX alone would be right for this process, and wrong for
# the NSS lookups DynamicUser= performs on its behalf, which is not
# something this file can verify.
IPAddressDeny=any

# It reads the journal and PID 1's state, never another process.
ProtectProc=invisible
ProcSubset=pid

# It creates no files. If a future version does, they are its own.
UMask=0077

# No [Install]: instances are started by systemd-ops-mcp.socket, which is
# the unit to enable.
