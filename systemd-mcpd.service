# systemd-mcpd: a hardened unit for the MCP server.
#
# Sample unit for socket-activated or supervised use. When run as an MCP
# stdio child by a client (the usual case), you don't need this file,
# but the hardening below is the recommended posture if you wrap it.

[Unit]
Description=Model Context Protocol server for systemd (read-only grants)
Documentation=https://modelcontextprotocol.io

[Service]
# Read scopes only. units:write is not granted here; add it only when
# this instance is expected to operate the machine rather than inspect
# it.
ExecStart=/usr/local/bin/systemd-mcpd --grant units:read,journal:read,boot:read
DynamicUser=yes
SupplementaryGroups=systemd-journal

# Full hardening. This instance grants read scopes only, so nothing
# here should hurt; if you grant units:write above, the hardening still
# applies, since systemctl talks to PID 1 over D-Bus, not the filesystem.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=

# The server talks to PID 1 over a Unix socket and runs systemctl,
# which talks D-Bus over another one. It opens no network socket, so
# deny IP traffic outright. RestrictAddressFamilies= is deliberately
# not set: AF_UNIX alone would be right for this process, and wrong for
# the NSS lookups DynamicUser= performs on its behalf, which is not
# something this file can verify.
IPAddressDeny=any

# It reads the journal and PID 1's state, never another process.
ProtectProc=invisible
ProcSubset=pid

# It creates no files. If a future version does, they are its own.
UMask=0077

[Install]
WantedBy=multi-user.target
