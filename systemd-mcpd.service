# systemd-mcpd: systemd confining the thing that talks to systemd.
#
# Sample unit for socket-activated or supervised use. When run as an MCP
# stdio child by a client (the usual case), you don't need this file —
# but the hardening below is the recommended posture if you wrap it.

[Unit]
Description=Model Context Protocol server for systemd (read-only grants)
Documentation=https://modelcontextprotocol.io

[Service]
# Read scopes only. units:write exists but is deliberately not granted
# here; grant it explicitly when this instance is supposed to operate
# the machine rather than inspect it.
ExecStart=/usr/local/bin/systemd-mcpd --grant units:read,journal:read,boot:read
DynamicUser=yes
SupplementaryGroups=systemd-journal

# Full hardening. This instance grants read scopes only, so nothing
# here should hurt; if you grant units:write above, the hardening still
# applies — systemctl talks to PID 1 over D-Bus, not the filesystem.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
